  "devDependencies": {
    "typescript": "^5.0.0",
    "@arlo-doc/config": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "vitest": "^2.0.0",
    "fast-check": "^3.21.0"
