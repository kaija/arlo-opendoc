{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "outDir": ".next",
    "baseUrl": ".",
    "paths": {
      "@arlo-doc/shared": ["../../packages/shared/src/index.ts"],
      "@arlo-doc/client": ["../../packages/client/src/types.ts"],
      "@arlo-doc/client/ipc": ["../../packages/client/src/ipc.ts"],
      "@arlo-doc/client/http": ["../../packages/client/src/http.ts"],
      "@arlo-doc/ui": ["../../packages/ui/src/index.ts"]
    },
    "allowJs": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": [
    "src/**/*",
    "next.config.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
